# iOS build output (the Xcode project is generated by XcodeGen)
ios/*.xcodeproj/
ios/build/
ios/Payload/
ios/Modem/Info.plist
*.ipa

# Downloaded build artifacts
dist/

# Logs (Sideloadly's daemon writes one into whatever folder it was started from;
# it contains the Apple ID and device identifiers)
*.log

# Windows: downloaded tools and the compiled bridge
windows/tools/
windows/ModemBridge.exe
windows/ModemBridge.old.exe
